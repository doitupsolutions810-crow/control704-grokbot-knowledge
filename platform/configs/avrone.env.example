# ChatBot Avrone Due'Krey / avrone-host environment
AVRONE_BASE_URL=http://127.0.0.1:9100
CUSTOM_URL=
ALLOW_AGENT_EXECUTION=false
MAX_AGENT_DEPTH=3

# Ports (daemon will pick free alternates if busy)
ORCHESTRATOR_PORT=9100
LITELLM_PORT=4000
VLLM_PORT=8000
COMPAT_PORT=9101
ARTIFACT_PORT=9102

# LLM via LiteLLM proxy
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_API_KEY=sk-avrone
LLM_MODEL=mock-gpt

# Provider keys (optional — mock works without)
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=

# Real vLLM (only when CUDA + vllm installed)
AVRONE_USE_REAL_VLLM=0
VLLM_MODEL=

# Feature flags
FEATURE_CHAT=true
FEATURE_SPAWN_AGENT=true
FEATURE_BUILDS=true
FEATURE_ARTIFACTS=true
FEATURE_TOOL_SHELL=false

DATABASE_URL=sqlite:///./data/avrone.db
SOURCE_DEFAULT=avrone-duekrey
KNOWLEDGE_ROOT=

# Set 1 to run real LiteLLM proxy CLI (needs litellm[proxy])
AVRONE_USE_LITELLM=0
